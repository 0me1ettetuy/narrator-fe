# Public URL the browser uses to call the separately deployed backend API.
# For local self-hosting, the backend default publishes port 3000.
VITE_BACKEND_URL="http://localhost:3000"
FRONTEND_PUBLISHED_PORT="5173"

# Docker-only URL used while this image generates its API client. Keep the
# default when the backend Compose project is running first.
OPENAPI_SOURCE_URL="http://api:3000"
